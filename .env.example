# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_optional

# AI Reasoning Configuration (AgentRouter / OpenRouter / Direct LLM)
AGENTROUTER_API_KEY=your_agentrouter_or_openrouter_api_key
AGENTROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet

# Sports Data API (The Odds API)
ODDS_API_KEY=your_odds_api_key_from_the_odds_api
ODDS_API_REGIONS=eu,uk,us

# Betting & Bankroll Defaults
DEFAULT_INITIAL_STAKE=1000.0
DEFAULT_CURRENCY=NGN
TARGET_DAILY_ODDS=1.50
WITHDRAWAL_CYCLE_DAYS=5
WITHDRAWAL_PERCENTAGE=0.50

# Scheduler
DAILY_BRIEFING_TIME=08:30
TIMEZONE=UTC
